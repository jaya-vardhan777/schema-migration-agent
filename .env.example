# =============================================================================
# schema-migrator — environment configuration
# =============================================================================
# Copy to `.env` and fill in the values you need. Only the block for your
# chosen LLM_PROVIDER is required; the others can be left blank.

# ---------- LLM provider selection --------------------------------------------
# One of: anthropic | openai | azure | bedrock
LLM_PROVIDER=anthropic

# Per-agent model overrides (optional). Leaving blank uses provider defaults.
LLM_MODEL_DEFAULT=
LLM_MODEL_ANALYZER=
LLM_MODEL_TYPE_MAPPER=
LLM_MODEL_VALIDATOR=

# ---------- Anthropic ---------------------------------------------------------
ANTHROPIC_API_KEY=

# ---------- OpenAI ------------------------------------------------------------
OPENAI_API_KEY=

# ---------- Azure OpenAI ------------------------------------------------------
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# ---------- AWS Bedrock (install with `pip install .[bedrock]`) --------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=

# ---------- LangSmith tracing (optional but recommended) ----------------------
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# ---------- Observability -----------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json           # json | console
METRICS_ENABLED=false
METRICS_PORT=9090

# ---------- Behavior ----------------------------------------------------------
MAX_VALIDATION_RETRIES=2
ENABLE_LLM_FALLBACK=true  # allow LLM for unknown types / ambiguous hints
